# --- Database ---
DATABASE_URL=postgresql://printer_saas:printer_saas@localhost:5432/printer_saas?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=debug

# Interval (seconds) after which an Agent with no heartbeat is considered offline.
# The Agent sends heartbeats every ~30s regardless of its collection cadence, so this can stay short.
AGENT_OFFLINE_THRESHOLD_SECONDS=120

# Interval (seconds) after which a printer with no new SNMP collection is considered offline.
# Must stay comfortably above the Agent's CollectionIntervalSeconds (default 900s/15min) so a
# printer isn't falsely flagged offline while just waiting for its next collection cycle.
PRINTER_OFFLINE_THRESHOLD_SECONDS=2400
