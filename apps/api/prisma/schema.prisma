generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PLATFORM / TENANCY
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  legalName String?
  document  String? // CNPJ
  email     String?
  phone     String?
  address   String?
  timezone  String       @default("America/Sao_Paulo")
  currency  String       @default("BRL")
  logoUrl   String?
  status    TenantStatus @default(ACTIVE)
  isDemo    Boolean      @default(false)
  // Configurações > Alertas > "Alertas de falha na comunicação" — null usa o
  // default global (AGENT_OFFLINE_THRESHOLD_SECONDS/PRINTER_OFFLINE_THRESHOLD_SECONDS
  // no .env), mesmo comportamento de antes desta feature.
  agentOfflineThresholdHours   Int?
  printerOfflineThresholdHours Int?
  planId    String?
  plan      Plan?        @relation(fields: [planId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                   User[]
  roles                   Role[]
  customers               Customer[]
  agents                  Agent[]
  printers                Printer[]
  snmpV3Credentials       SnmpV3Credential[]
  serviceOrders           ServiceOrder[]
  contracts               Contract[]
  auditLogs               AuditLog[]
  alerts                  Alert[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  financialEntries        FinancialEntry[]
  consumableReplacements  ConsumableReplacement[]
  printerComments         PrinterComment[]
  monthlyClosings         MonthlyClosing[]
  contractPrinters        ContractPrinter[]
  contractFixedCosts      ContractFixedCost[]
  contractEmailRecipients ContractEmailRecipient[]
  contractReadjustments   ContractReadjustment[]
  contractPricingTiers    ContractPricingTier[]
  reportEmailRecipients   ReportEmailRecipient[]
  userPermissions         UserPermission[]
  userVisibleCustomers    UserVisibleCustomer[]
  emailSettings           TenantEmailSettings?
  notificationTypeSettings NotificationTypeSetting[]
  notificationTypeCustomers NotificationTypeCustomer[]
  reportDeliveries        ReportDelivery[]
  reportDeliveryCustomers ReportDeliveryCustomer[]
  serviceOrderParts       ServiceOrderPart[]
  serviceOrderPhotos      ServiceOrderPhoto[]
  workingHours            TenantWorkingHours[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  printerErrorCodes       PrinterErrorCodeCatalog[]
  serviceOrderTypes       ServiceOrderTypeCatalog[]
  departments             Department[]
  closingSettings         TenantClosingSettings?
  supplyLevelFilters      SupplyLevelFilter[]

  @@map("tenants")
}

/**
 * Platform-level plan/limits (spec §78). No automatic billing/enforcement
 * yet — deliberately deferred by the spec itself ("não precisa implementar
 * cobrança automática... mas o banco deverá permitir isso futuramente").
 * A null limit means unlimited.
 */
model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  maxUsers     Int?
  maxCustomers Int?
  maxPrinters  Int?
  maxAgents    Int?
  priceMonthly Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

// Global (not tenant-scoped) researched catalog of exact printer models —
// same category as Plan/Permission: platform-wide hardware facts, not
// tenant commercial data (see PlatformController's own comment). Populated
// via real research (manufacturer datasheets/docs, see
// docs/printer-catalog/), managed by the Super Admin at
// /plataforma → "Catálogo de impressoras". Never guessed — a field left
// null in `capabilities` means "a confirmar", same tri-state rule as
// Printer.capabilities itself.
model PrinterCatalogModel {
  id                String            @id @default(uuid())
  manufacturer      String
  model             String
  family            String?
  // Alternate raw strings (e.g. a compact SNMP/IPP-reported code like
  // "SAMSUNGM4070") that should also match this catalog entry.
  aliases           String[]          @default([])
  deviceType        PrinterDeviceType @default(PRINTER)
  capabilities      Json // {color, duplex, a3, copy, scan, fax} — true/false/absent=a confirmar
  countersAvailable Json? // which counter types to expect (total/pb/colorido/duplex/copias/scanner)
  suppliesAvailable Json? // which supply types to expect (toner_preto/ciano/magenta/amarelo/...)
  confidence        String // ALTA | MEDIA | BAIXA
  status            String            @default("ATUAL") // ATUAL | DESCONTINUADO | ANTIGO | A_CONFIRMAR
  sourcePrimary     String?
  sourcesSecondary  String?
  notes             String?
  researchedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  printers Printer[]

  @@index([manufacturer, model])
  @@map("printer_catalog_models")
}

// Global (not tenant-scoped) — same category as PrinterCatalogModel/Plan,
// platform-wide release metadata, not tenant data. The Agent polls
// GET /agent-api/v1/latest-release and compares `version` (SemVer) against
// its own AgentVersion.Current; `isActive` lets the Super Admin publish a
// release without every Agent picking it up yet (staged rollout) or pull a
// bad release without deleting its history. The MSI binary itself is NOT
// hosted here — downloadUrl just points wherever it's actually hosted
// (GitHub Release, S3, ...); this table only carries the metadata needed to
// find it and trust it (sha256 for integrity, signingCertThumbprint as the
// Agent's second, locally-pinned check — see AuthenticodeVerifier.cs in
// PrinterAgent.Core, which never trusts a thumbprint the server supplies on
// its own, only compares against one compiled into the Agent itself).
model AgentRelease {
  id                     String   @id @default(uuid())
  version                String // SemVer, e.g. "1.1.0"
  downloadUrl            String
  sha256                 String // hex digest of the .msi, checked before the Agent trusts the signature at all
  signingCertThumbprint  String? // informational only — the Agent's real trust check is its own compiled-in constant, not this field
  releaseNotes           String?
  isActive               Boolean  @default(true)
  publishedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("agent_releases")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

// STAFF = colaborador (equipe interna); CUSTOMER = conta de portal do
// cliente (o que customerId != null já significava — explícito aqui porque
// a tela de criação precisa saber o tipo ANTES do resto do formulário, pra
// decidir qual checklist de permissões mostrar).
enum AccountType {
  STAFF
  CUSTOMER
}

model User {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  status       UserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])
  isSuperAdmin Boolean     @default(false)
  accountType  AccountType @default(STAFF)
  // Set only for customer-portal users (spec §34): scopes every portal
  // query to this single customer, on top of the normal tenant scoping.
  // NULL for regular tenant staff (admin/technician/finance/...).
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Only meaningful for accountType=STAFF: true (default) sees every
  // customer in the tenant; false restricts to UserVisibleCustomer rows.
  viewAllCustomers Boolean @default(true)

  // E-mail notification preferences — some only make sense for one account
  // type (e.g. notifyTicketAssigned for STAFF, notifyTicketClosed for
  // CUSTOMER) but all live on User since an account is exactly one type.
  notifyTicketAssigned    Boolean @default(false)
  notifyTicketSlaExpiring Boolean @default(false)
  notifyTicketSlaBreached Boolean @default(false)
  notifyTicketClosed      Boolean @default(false)
  // No trigger wired yet — there is no service-order comment feature at
  // all today, so this is stored for when that feature exists.
  notifyTicketCommented   Boolean @default(false)

  // Soft delete — same rationale as deactivate (see status): preserves
  // audit trail and any ServiceOrder/PrinterComment/AuditLog history a
  // deleted account is attached to. Every user query filters this out.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  technicianServiceOrders ServiceOrder[]        @relation("technician")
  createdServiceOrders    ServiceOrder[]        @relation("createdServiceOrders")
  printerComments         PrinterComment[]
  directPermissions       UserPermission[]
  visibleCustomers        UserVisibleCustomer[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Direct permission grants (no Role in between) — how the new
// account-creation checklist assigns permissions. Reuses the same
// Permission table RolePermission already uses, so @RequirePermissions
// checks work identically regardless of whether a permission came from a
// Role or a direct grant (see PermissionsGuard/jwt.strategy.ts).
model UserPermission {
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([tenantId])
  @@map("user_permissions")
}

// Which customers a STAFF user with viewAllCustomers=false may see. Only
// enforced today in the Clientes list (CustomersService.findAll) — not yet
// propagated to printers/contracts/OS/financeiro, documented as a larger
// follow-up.
model UserVisibleCustomer {
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
  @@index([tenantId])
  @@map("user_visible_customers")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// "Esqueci minha senha" — mesmo padrão do RefreshToken (só o hash do token
// é guardado, nunca o valor em si; usedAt marca consumo em vez de apagar,
// preservando o histórico). Não é tenant-scoped pelo mesmo motivo do
// RefreshToken: é resolvido pelo hash do token, nunca por tenantId.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "printers.view"
  description String?

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CUSTOMERS / LOCATIONS
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerPersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY // Pessoa Jurídica
}

model Customer {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personType            CustomerPersonType @default(COMPANY)
  legalName             String
  tradeName             String?
  document              String? // CPF ou CNPJ, conforme personType
  stateRegistration     String?
  municipalRegistration String?
  email                 String?
  phone                 String?
  whatsapp              String?
  financialEmail        String?
  supportEmail          String?
  contactName           String?
  contactRole           String?
  address               String? // legado — mantido para não perder dado já preenchido, o formulário novo usa os campos estruturados abaixo
  zipCode               String?
  street                String?
  number                String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String?
  country               String?            @default("Brasil")
  notes                 String?
  status                CustomerStatus     @default(ACTIVE)
  slaHours              Int? // overrides the applicable contract's SLA for this customer's service orders
  // SLA ligado/desligado por cliente + como contar as horas de atendimento.
  // A matemática de "horas úteis" (pular fim de semana/fora do expediente) no
  // cálculo real de vencimento de OS fica pra uma etapa futura — isto aqui é
  // só o modelo de dados + a tela de configuração.
  slaEnabled            Boolean            @default(false)
  slaHourMode           SlaHourMode        @default(CALENDAR)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  locations        Location[]
  printers         Printer[]
  contracts        Contract[]
  serviceOrders    ServiceOrder[]
  financialEntries FinancialEntry[]
  portalUsers      User[]
  monthlyClosings  MonthlyClosing[]
  workingHours     CustomerWorkingHours[]
  agents           Agent[]
  visibleToUsers   UserVisibleCustomer[]
  notificationTypeSettings NotificationTypeCustomer[]
  reportDeliveries         ReportDeliveryCustomer[]
  supplyLevelFilters       SupplyLevelFilter[]

  @@index([tenantId])
  @@map("customers")
}

enum SlaHourMode {
  CALENDAR // horas corridas
  BUSINESS_HOURS_COMPANY // horas úteis da empresa (TenantWorkingHours)
  BUSINESS_HOURS_CUSTOMER // horas úteis do cliente (CustomerWorkingHours)
}

model CustomerWorkingHours {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = domingo .. 6 = sábado
  startTime  String // "08:00"
  endTime    String // "18:00"
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_working_hours")
}

// Horário de trabalho da empresa (tenant) — usado quando um cliente está no
// modo "horas úteis da minha empresa". Mesma forma do CustomerWorkingHours,
// só que um por tenant, editado em Configurações.
model TenantWorkingHours {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_working_hours")
}

model Location {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  // Só relevantes pro endereço principal (isPrimary=true) na prática, mas
  // ficam no model todo — um "outro endereço" pode virar principal depois.
  department   String?
  costCenter   String?
  // Só um Location por cliente pode ter isPrimary=true — reforçado no
  // service (CustomersService.setPrimaryLocation), não no schema.
  isPrimary    Boolean  @default(false)
  notes        String?
  slaHours     Int? // overrides customer/contract SLA for service orders at this location
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agents        Agent[]
  printers      Printer[]
  serviceOrders ServiceOrder[]

  @@index([tenantId])
  @@index([customerId])
  @@map("locations")
}

// Configurações > Informações da empresa > Departamentos — um catálogo
// próprio do tenant (não o Location.department de texto livre acima, que é
// por endereço de um cliente); usado pra classificar Printer.departmentId.
model Department {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printers Printer[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// AGENTS
// ---------------------------------------------------------------------------

enum AgentStatus {
  PENDING // token generated, not yet enrolled
  ONLINE
  OFFLINE
  DISABLED
}

model Agent {
  id                        String            @id @default(uuid())
  tenantId                  String
  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Independent of locationId — a customer with no Location registered yet
  // can still have an Agent slot created for them (the "Adicionar Agent"
  // dialog's customer picker used to only narrow the location dropdown and
  // discard the choice if no location was picked, silently leaving the
  // Agent unlinked to anything). locationId is still the more specific
  // "which unit" detail when it's known.
  customerId                String?
  customer                  Customer?         @relation(fields: [customerId], references: [id])
  locationId                String?
  location                  Location?         @relation(fields: [locationId], references: [id])
  name                      String
  enrollmentToken           String?           @unique // single-use, cleared after enrollment
  enrollmentTokenExpiresAt  DateTime?
  apiKeyHash                String? // credential issued after enrollment
  status                    AgentStatus       @default(PENDING)
  hostname                  String?
  localIp                   String?
  osVersion                 String?
  agentVersion              String?
  lastHeartbeatAt           DateTime?
  discoveryConfig           Json? // subnets / ip ranges / snmp settings
  // Fallback SNMP v3 credential used for any printer under this Agent that
  // doesn't have its own snmpV3CredentialId override. Optional — an Agent
  // with neither this nor any per-printer override just falls back to v1/v2c
  // community string, same as before this feature existed.
  defaultSnmpV3CredentialId String?
  defaultSnmpV3Credential   SnmpV3Credential? @relation("AgentDefaultSnmpV3Credential", fields: [defaultSnmpV3CredentialId], references: [id])
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  printers Printer[]

  @@index([tenantId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// SNMP V3 CREDENTIALS
// ---------------------------------------------------------------------------

// Tenant-scoped, reusable SNMP v3 credential set — a tenant typically has one
// or a handful of these (e.g. "Credencial padrão", "Filial X"), assigned to
// individual printers (Printer.snmpV3CredentialId) or left as an Agent's
// default (Agent.defaultSnmpV3CredentialId). Never sent back to the frontend
// with passwords decrypted — see SecretCryptoService / SnmpCredentialsService.
model SnmpV3Credential {
  id                              String   @id @default(uuid())
  tenantId                        String
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                            String // human label, e.g. "Credencial padrão HQ"
  userName                        String
  securityLevel                   String   @default("authPriv") // noAuthNoPriv | authNoPriv | authPriv
  authenticationProtocol          String? // MD5 | SHA1 | SHA256 | SHA384 | SHA512
  authenticationPasswordEncrypted String? // AES-256-GCM ciphertext, never plaintext at rest
  privacyProtocol                 String? // DES | AES128 | AES192 | AES256
  privacyPasswordEncrypted        String? // AES-256-GCM ciphertext, never plaintext at rest
  contextName                     String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  printers         Printer[]
  defaultForAgents Agent[]   @relation("AgentDefaultSnmpV3Credential")

  @@index([tenantId])
  @@map("snmp_v3_credentials")
}

// ---------------------------------------------------------------------------
// PRINTERS
// ---------------------------------------------------------------------------

enum PrinterStatus {
  DISCOVERED // seen by agent, not yet claimed
  MONITORED
  IGNORED
  DECOMMISSIONED
}

enum PrinterCollectionMethod {
  SNMP
  MANUAL
}

// Only PRINTER/MFP/PLOTTER ever reach here via submitDevices — the API
// re-validates this server-side (defense in depth), it doesn't just trust
// the Agent's own classification. Everything else exists so a rejected
// device's classification can still be logged/diagnosed.
enum PrinterDeviceType {
  UNKNOWN
  PRINTER
  MFP
  PLOTTER
  ROUTER
  FIREWALL
  SWITCH
  ACCESS_POINT
  SERVER
  COMPUTER
  CAMERA
}

enum PrinterOnlineStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

model Printer {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  status           PrinterStatus           @default(DISCOVERED)
  onlineStatus     PrinterOnlineStatus     @default(UNKNOWN)
  collectionMethod PrinterCollectionMethod @default(SNMP)

  ip           String?
  mac          String?
  hostname     String?
  serial       String? // primary identity when available
  manufacturer String?
  model        String?
  firmware     String?
  sysDescr     String?

  fingerprint String // stable dedup key: serial || mac || (agentId+ip)

  lastSeenAt      DateTime?
  lastCollectedAt DateTime?
  monitoredAt     DateTime? // when this printer's status first became MONITORED (spec: never backfilled/guessed for pre-existing rows)

  slaHours Int? // overrides location/customer/contract SLA for service orders on this printer

  // Null = never determined (device doesn't expose the Printer-MIB input
  // tray table). true/false = derived from an actual declared tray size at
  // least once — never guessed from the model name. Drives whether the UI
  // shows A3-specific fields at all for this printer. Kept as its own
  // column for backward compatibility — mirrors capabilities.a3 below.
  supportsA3 Boolean?

  deviceType               PrinterDeviceType @default(UNKNOWN)
  classificationConfidence Float?
  // Tri-state per capability ({color,duplex,a3,copy,scan,fax}: true/false/absent=unknown) —
  // never a fixed field per capability, since not every printer has every one (spec: never
  // invent, never treat "not reported" as false). See Classification/DeviceClassifier.cs.
  capabilities             Json?
  capabilitySources        Json? // {"duplex": "ipp", ...} — which source determined each capability, for troubleshooting
  discoveryDiagnostics     Json? // {"snmp": "success", "ipp": "not_available", ...} — per-protocol outcome, troubleshooting only

  // Presence of this FK *is* "homologada" — matched against the global
  // researched catalog by manufacturer+model in AgentsService.submitDevices.
  // Only ever fills capabilities the live probe left null, never overrides
  // a live-confirmed true/false (same priority rule already used for A3).
  catalogModelId String?
  catalogModel   PrinterCatalogModel? @relation(fields: [catalogModelId], references: [id])

  // Per-printer SNMP v3 credential override — takes priority over the
  // owning Agent's defaultSnmpV3CredentialId. Both are optional; a printer
  // with neither uses v1/v2c community string like before this feature.
  snmpV3CredentialId String?
  snmpV3Credential   SnmpV3Credential? @relation(fields: [snmpV3CredentialId], references: [id])

  // Configurações > Informações da empresa > Departamentos.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  counters                       CounterReading[]
  consumables                    ConsumableReading[]
  alerts                         Alert[]
  errorCodeReadings              PrinterAlertReading[]
  serviceOrders                  ServiceOrder[]
  contracts                      Contract[]
  replacements                   ConsumableReplacement[]
  comments                       PrinterComment[]
  contractPrinters               ContractPrinter[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]

  @@unique([tenantId, fingerprint])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("printers")
}

// Raw + derived counter snapshot per collection
model CounterReading {
  id          String   @id @default(uuid())
  printerId   String
  printer     Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  total       Int?
  blackWhite  Int?
  color       Int?
  copies      Int?
  raw         Json? // original values + OIDs as received from agent
  collectedAt DateTime @default(now())

  @@index([printerId, collectedAt])
  @@map("counter_readings")
}

model ConsumableReading {
  id           String   @id @default(uuid())
  printerId    String
  printer      Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  type         String // toner, drum, waste_toner, etc.
  color        String? // black, cyan, magenta, yellow
  levelPercent Int?
  capacity     String?
  name         String?
  serial       String?
  collectedAt  DateTime @default(now())

  @@index([printerId, collectedAt])
  @@map("consumable_readings")
}

// Raw alert/error state read straight from the printer's own Printer-MIB
// prtAlertTable (RFC 3805, vendor-agnostic standard OID — see
// PrinterMibOids.cs on the Agent side) — distinct from the `Alert` model,
// which is this SaaS's own monitoring alerts (offline, low supply, etc.).
// `description` is whatever text the printer itself reports (often terse or
// vendor-jargon); `code` is optionally cross-referenced against
// PrinterErrorCodeCatalog client-side for a friendlier label when a match
// exists, but this table never depends on that catalog existing.
model PrinterAlertReading {
  id          String   @id @default(uuid())
  printerId   String
  printer     Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  code        String?
  description String?
  severity    String? // printer's own severity word (e.g. "critical", "warning"), never invented when absent
  collectedAt DateTime @default(now())

  @@index([printerId, collectedAt])
  @@map("printer_alert_readings")
}

enum ConsumableReplacementStatus {
  PREDICTED // forecast computed, no replacement seen yet
  CONFIRMED // level jumped back up — treated as an actual physical replacement
  PREMATURE // confirmed, but swapped with plenty of life left (possible waste)
  DISMISSED // manually discarded by the user
}

// Tracks the lifecycle of a printer's consumable (toner/drum/etc.) from
// forecasted replacement date through to confirmation, so providers can see
// predicted vs. actual replacements and catch premature (wasteful) swaps.
model ConsumableReplacement {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)
  type      String
  color     String?

  predictedAt               DateTime?
  replacedAt                DateTime?
  levelPercentAtReplacement Int?
  status                    ConsumableReplacementStatus @default(PREDICTED)

  inventoryMovementId String?
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id])

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([printerId, type, color])
  @@map("consumable_replacements")
}

// Suprimentos > Níveis dos suprimentos: um filtro salvo e nomeado, sempre
// escopado a um único cliente (spec do usuário: "por cada cliente"). Não
// guarda nenhuma leitura em si — ao abrir, a tela busca ao vivo as
// impressoras desse cliente com a última leitura de cada consumível, então
// o filtro nunca fica desatualizado.
model SupplyLevelFilter {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("supply_level_filters")
}

model PrinterComment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerId String
  printer   Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([printerId, createdAt])
  @@map("printer_comments")
}

// ---------------------------------------------------------------------------
// ALERTS
// ---------------------------------------------------------------------------

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  PRINTER_OFFLINE
  AGENT_OFFLINE
  TONER_LOW
  TONER_CRITICAL
  COUNTER_STALE
  DEVICE_ERROR
  CONTRACT_EXPIRING
  SERVICE_ORDER_LATE
  SLA_EXPIRING
  COLLECTION_FAILED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerId      String?
  printer        Printer?      @relation(fields: [printerId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  type           AlertType
  level          AlertLevel
  status         AlertStatus   @default(OPEN)
  message        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([tenantId, status])
  @@map("alerts")
}

// Configurações > Alertas > "Alertas de manutenção preventiva". Scanned daily
// by apps/worker/src/jobs/preventive-maintenance.processor.ts — when
// nextDueAt is reached, auto-creates a ServiceOrder (serviceType:
// PREVENTIVE_MAINTENANCE, already an existing enum value, no migration
// needed there) and advances nextDueAt by intervalDays.
model PreventiveMaintenanceSchedule {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printerId       String
  printer         Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  intervalDays    Int
  lastTriggeredAt DateTime?
  nextDueAt       DateTime
  active          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@map("preventive_maintenance_schedules")
}

// Configurações > Alertas > catálogo de códigos de erro. Reference-only for
// now (manual lookup by staff) — the Agent doesn't collect a raw
// manufacturer error/status code yet, so nothing auto-matches against this
// table yet; see the module's own doc comment for what's still pending.
model PrinterErrorCodeCatalog {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturer String
  code         String
  description  String
  severity     AlertLevel @default(WARNING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@map("printer_error_code_catalog")
}

// ---------------------------------------------------------------------------
// SERVICE ORDERS
// ---------------------------------------------------------------------------

enum ServiceOrderStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  WAITING_PART
  WAITING_CUSTOMER
  DONE
  CANCELLED
}

enum ServiceOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceOrderType {
  CORRECTIVE_MAINTENANCE
  PREVENTIVE_MAINTENANCE
  INSTALLATION
  EQUIPMENT_REPLACEMENT
  DELIVERY_PICKUP
  PRINT_ISSUE
  CONFIGURATION
  TECHNICAL_SUPPORT
  OTHER
}

enum ServiceOrderBillingType {
  CONTRACT
  CHARGE_CUSTOMER
  WARRANTY
  COURTESY
}

enum ServiceOrderPhotoPhase {
  BEFORE
  AFTER
}

model ServiceOrder {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number          Int
  title           String?
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  printerId       String?
  printer         Printer?  @relation(fields: [printerId], references: [id])
  technicianId    String?
  technician      User?     @relation("technician", fields: [technicianId], references: [id])
  createdByUserId String?
  createdBy       User?     @relation("createdServiceOrders", fields: [createdByUserId], references: [id])

  type             String? // legado, sem uso na UI nova — ver serviceType
  serviceType      ServiceOrderType?
  // Catálogo gerenciável (Configurações > Chamados) que substitui o enum
  // acima na UI nova — o enum fica só como valor legado/fallback pra
  // registros antigos, nunca removido (migração aditiva, ver
  // ServiceOrderTypeCatalog).
  serviceOrderTypeCatalogId String?
  serviceOrderTypeCatalog   ServiceOrderTypeCatalog? @relation(fields: [serviceOrderTypeCatalogId], references: [id])
  priority         ServiceOrderPriority @default(MEDIUM)
  status           ServiceOrderStatus   @default(OPEN)
  description      String?
  symptoms         String[]             @default([])
  counterAtOpening Int? // snapshot do contador total do printer no momento da abertura

  diagnosis       String?
  causeIdentified String?
  testsPerformed  String?
  defectiveParts  String?
  suppliesUsed    String?
  technicalNotes  String?
  solution        String?

  billingType ServiceOrderBillingType?
  laborCost   Decimal?                 @db.Decimal(12, 2)
  travelCost  Decimal?                 @db.Decimal(12, 2)

  arrivedAt         DateTime?
  departedAt        DateTime?
  mileageKm         Int?
  activityPerformed String?
  attendanceNotes   String?

  equipmentWorking Boolean?

  approvalName      String?
  approvalAt        DateTime?
  approvalSignature String? // PNG base64 data URL captured on a signature canvas
  approvalNotes     String?

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  slaDueAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialEntries   FinancialEntry[]
  inventoryMovements InventoryMovement[]
  alerts             Alert[]
  parts              ServiceOrderPart[]
  photos             ServiceOrderPhoto[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("service_orders")
}

// Configurações > Chamados — substitui a escolha fixa do enum
// ServiceOrderType na tela de abertura de chamado por um catálogo que o
// tenant gerencia (nome, preço padrão do serviço, linhas em branco na
// impressão).
model ServiceOrderTypeCatalog {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  defaultPrice      Decimal?      @db.Decimal(12, 2)
  blankLinesOnPrint Int           @default(0)
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  serviceOrders ServiceOrder[]

  @@index([tenantId])
  @@map("service_order_type_catalog")
}

model ServiceOrderPart {
  id                  String       @id @default(uuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrderId      String
  serviceOrder        ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  name                String
  quantity            Int
  unitValue           Decimal      @db.Decimal(12, 2)
  inventoryItemId     String?
  inventoryMovementId String?
  createdAt           DateTime     @default(now())

  @@index([tenantId])
  @@map("service_order_parts")
}

model ServiceOrderPhoto {
  id             String                 @id @default(uuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  phase          ServiceOrderPhotoPhase
  path           String
  createdAt      DateTime               @default(now())

  @@index([tenantId])
  @@map("service_order_photos")
}

// ---------------------------------------------------------------------------
// CONTRACTS
// ---------------------------------------------------------------------------

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ENDED
  EXPIRED
}

model Contract {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number     Int
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  printerId  String?
  printer    Printer? @relation(fields: [printerId], references: [id])

  startDate         DateTime
  endDate           DateTime?
  monthlyFee        Decimal        @db.Decimal(12, 2)
  franchisePages    Int            @default(0)
  overagePriceBw    Decimal        @default(0) @db.Decimal(12, 4)
  overagePriceColor Decimal        @default(0) @db.Decimal(12, 4)
  billingDay        Int            @default(1)
  slaHours          Int?
  readjustmentIndex String?
  status            ContractStatus @default(DRAFT)
  notes             String?
  printNotesOnClosing Boolean @default(false)

  // Default per-page cost, used as a fallback for any linked ContractPrinter
  // that doesn't have its own override (spec: "custo padrão"). Supersedes
  // franchisePages/overagePriceBw/Color for billing purposes going forward —
  // those columns stay populated for historical contracts but are no longer
  // read by ClosingsService.
  defaultPriceBw    Decimal? @db.Decimal(12, 4)
  defaultPriceColor Decimal? @db.Decimal(12, 4)
  defaultPriceScan  Decimal? @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialEntries FinancialEntry[]
  contractPrinters ContractPrinter[]
  fixedCosts       ContractFixedCost[]
  emailRecipients  ContractEmailRecipient[]
  readjustments    ContractReadjustment[]
  pricingTiers     ContractPricingTier[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("contracts")
}

// One row per page-range bracket of a contract's progressive/tiered pricing
// (spec: "tabela de faixas de páginas"). Pages consumed within [fromPage,
// toPage] in a period are billed at pricePerPage for that bracket, like a
// tax bracket — see calculateTieredBilling in packages/shared/src/billing.ts
// for the exact math. toPage: null means "no upper bound" (last bracket).
model ContractPricingTier {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fromPage     Int
  toPage       Int?
  pricePerPage Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, contractId])
  @@map("contract_pricing_tiers")
}

// One row per printer billed under a contract (a contract can now cover many
// printers, each with its own per-page pricing — Contract.printerId above is
// the legacy single-printer link, kept for old contracts/reports).
model ContractPrinter {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  printerId  String
  printer    Printer  @relation(fields: [printerId], references: [id])

  priceBw    Decimal? @db.Decimal(12, 4) // null = falls back to Contract.defaultPriceBw
  priceColor Decimal? @db.Decimal(12, 4)
  priceScan  Decimal? @db.Decimal(12, 4)
  fixedCost  Decimal  @default(0) @db.Decimal(12, 2)

  // Configurações > Informações da empresa >
  // "Desabilitar manualmente o monitoramento das impressoras nos contratos"
  // — quando true, checkOffline() no worker pula esta impressora pra este
  // contrato (não fica marcando OFFLINE/gerando alerta de comunicação).
  monitoringDisabled Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([contractId, printerId])
  @@index([tenantId])
  @@map("contract_printers")
}

model ContractFixedCost {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  label      String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("contract_fixed_costs")
}

model ContractEmailRecipient {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime @default(now())

  @@unique([contractId, email])
  @@index([tenantId])
  @@map("contract_email_recipients")
}

enum ContractReadjustmentStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

model ContractReadjustment {
  id                 String                     @id @default(uuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  percentage         Decimal                    @db.Decimal(6, 2)
  effectiveMonth     Int // 1-12
  effectiveYear      Int
  status             ContractReadjustmentStatus @default(SCHEDULED)
  previousMonthlyFee Decimal?                   @db.Decimal(12, 2)
  newMonthlyFee      Decimal?                   @db.Decimal(12, 2)
  appliedAt          DateTime?
  createdAt          DateTime                   @default(now())

  @@index([tenantId, contractId])
  @@map("contract_readjustments")
}

enum ClosingStatus {
  PENDING
  FROZEN
}

// Snapshot of a customer's monthly billing closing — generated on demand
// from Contract/CounterReading data. PENDING can be regenerated/overwritten
// freely (e.g. re-run after a late counter reading comes in); once FROZEN,
// ClosingsService.generate() refuses to overwrite it silently — it has to be
// explicitly unfrozen first. This is what "congelado"/"pendente" in the
// daily digest email refers to.
model MonthlyClosing {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  referenceYear  Int
  referenceMonth Int // 1-12
  totalAmount    Decimal       @db.Decimal(12, 2)
  details        Json // per-contract breakdown snapshot at generation time
  status         ClosingStatus @default(PENDING)
  frozenAt       DateTime?
  generatedAt    DateTime      @default(now())
  // Editável só quando TenantClosingSettings.allowEditingClosingDocumentNumber
  // estiver ligado — null usa a identificação padrão (referenceMonth/Year).
  documentNumber String?

  @@unique([tenantId, customerId, referenceYear, referenceMonth])
  @@index([tenantId, customerId])
  @@map("monthly_closings")
}

// Tenant-wide (not per-contract) list of who receives the daily closing
// digest email — replaces the old per-contract ContractEmailRecipient for
// this purpose; see Configurações > "Envio de relatórios por e-mail".
model ReportEmailRecipient {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("report_email_recipients")
}

// ---------------------------------------------------------------------------
// EMAIL SETTINGS (Configurações > E-mail): provedor de envio por tenant,
// filtro de notificações por cliente, e roteamento de relatórios por cliente.
// ---------------------------------------------------------------------------

enum EmailProvider {
  SMTP
  MICROSOFT365
}

// Uma linha por tenant. Quando não existe (ou o provedor escolhido não tem
// as credenciais preenchidas), o worker cai pro SMTP global do .env — mesmo
// comportamento de antes desta feature, sem regressão pra quem não configurar.
model TenantEmailSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider EmailProvider @default(SMTP)

  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPasswordEncrypted String? // AES-256-GCM via SecretCryptoService, nunca em texto puro
  smtpFrom              String?

  // Microsoft 365 — Microsoft Graph, client-credentials (app-only). Requer um
  // App Registration no Azure AD do próprio tenant final com a permissão
  // Mail.Send (aplicativo) consentida por um admin — não algo que dá pra
  // gerar por aqui, só armazenar/usar o que o usuário colar.
  m365TenantId              String?
  m365ClientId              String?
  m365ClientSecretEncrypted String?
  m365SenderUpn             String? // caixa de e-mail usada como remetente (users/{upn}/sendMail)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_email_settings")
}

// Configurações > Informações da empresa (aba Empresa + aba Configurações de
// relatório) — singleton por tenant, mesmo padrão de TenantEmailSettings.
// closingReportColumns/printUsageReportColumns guardam o estado de TODOS os
// checkboxes pedidos (~60 colunas ao todo); só o subconjunto com dado real
// hoje é de fato lido por ClosingsService.generatePdf — o resto fica
// guardado sem efeito até existir coleta desse dado (ver doc do service).
model TenantClosingSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  allowDisablingPrinterMonitoring   Boolean @default(false)
  allowEditingClosingDocumentNumber Boolean @default(false)
  hideUnknownLevelSupplies          Boolean @default(false)
  hideNonTonerSupplies              Boolean @default(false)

  closingReportTitle      String  @default("Relatório de Fechamento")
  closingReportColumns    Json    @default("{}")
  printUsageReportColumns Json    @default("{}")
  additionalText          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_closing_settings")
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_SLA_EXPIRING
  TICKET_SLA_BREACHED
  TICKET_CLOSED
  TICKET_COMMENTED
}

// Filtro por cliente em cima do que o usuário já marcou no perfil dele
// (User.notifyTicket*) — as duas coisas precisam permitir pro e-mail sair.
// Sem linha configurada pra um tipo = habilitado pra todos os clientes.
model NotificationTypeSetting {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         NotificationType
  allCustomers Boolean           @default(true)
  customers    NotificationTypeCustomer[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([tenantId, type])
  @@map("notification_type_settings")
}

model NotificationTypeCustomer {
  tenantId   String
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settingId  String
  setting    NotificationTypeSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([settingId, customerId])
  @@index([tenantId])
  @@map("notification_type_customers")
}

enum ReportType {
  PRINTER_USAGE // Digitação por impressora
  CLOSING_DIGEST // Resumo diário de fechamentos
  PRINTER_USAGE_WITH_COPIES // Digitação e cópias por impressora
}

enum CustomerEmailField {
  EMAIL
  FINANCIAL_EMAIL
  SUPPORT_EMAIL
}

// Pra quem cada tipo de relatório é enviado — todos os clientes ou uma lista
// específica, usando um e-mail já cadastrado no próprio Customer (nunca um
// e-mail digitado à mão aqui).
model ReportDelivery {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportType   ReportType
  allCustomers Boolean             @default(true)
  emailField   CustomerEmailField  @default(EMAIL)
  customers    ReportDeliveryCustomer[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, reportType])
  @@map("report_deliveries")
}

model ReportDeliveryCustomer {
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryId String
  delivery   ReportDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([deliveryId, customerId])
  @@index([tenantId])
  @@map("report_delivery_customers")
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model InventoryItem {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        String
  // Campos abaixo só existem para peças/suprimentos "de catálogo" (toner,
  // cilindro, fusor, etc.) — todos opcionais no banco porque itens de
  // estoque genéricos anteriores a esta feature não têm esse detalhamento.
  code                  String? // código/SKU interno do suprimento
  manufacturer          String?
  model                 String? // ex.: "TN650" — obrigatório só na tela de criação, não no banco
  color                 String?
  standardLifespanPages Int? // vida útil padrão declarada pelo fabricante, em páginas
  costPrice             Decimal? @db.Decimal(12, 2)
  salePrice             Decimal? @db.Decimal(12, 2)
  notes                 String?
  quantity              Int      @default(0)
  minQuantity           Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  movements InventoryMovement[]

  @@index([tenantId])
  @@map("inventory_items")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryMovement {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           InventoryMovementType
  quantity       Int
  reason         String?
  serviceOrderId String?
  serviceOrder   ServiceOrder?         @relation(fields: [serviceOrderId], references: [id])
  createdAt      DateTime              @default(now())

  consumableReplacements ConsumableReplacement[]

  @@index([tenantId])
  @@index([itemId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// FINANCIAL
// ---------------------------------------------------------------------------

enum FinancialEntryType {
  RECEIVABLE
  PAYABLE
}

enum FinancialEntryStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model FinancialEntry {
  id          String               @id @default(uuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        FinancialEntryType
  category    String
  costCenter  String?
  description String?
  amount      Decimal              @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      FinancialEntryStatus @default(PENDING)

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type, status])
  @@index([tenantId, dueDate])
  @@map("financial_entries")
}
