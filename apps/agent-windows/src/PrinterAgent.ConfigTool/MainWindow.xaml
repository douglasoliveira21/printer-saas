<Window x:Class="PrinterAgent.ConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrinterAgent.ConfigTool"
        mc:Ignorable="d"
        Title="Vgon Printer Agent" Height="760" Width="900"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Icon="agent.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Slim top bar: identity + service status + Start/Stop/Uninstall. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Vgon Printer Agent" Style="{StaticResource TitleText}" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Verificando status..." FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  Servidor: " Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ApiUrlText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="InstallButton" Content="Instalar e Iniciar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="InstallButton_Click"/>
                    <Button x:Name="StartButton" Content="Iniciar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="Parar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="StopButton_Click"/>
                    <Button x:Name="UninstallButton" Content="Desinstalar" Style="{StaticResource SecondaryButton}" Click="UninstallButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Install/enrollment fields — only relevant (and visible) before the service is installed. -->
        <StackPanel x:Name="SetupPanel" Grid.Row="1" Margin="20,16,20,4">
            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="TokenSectionLabel" Text="Token de instalação" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="TokenSectionCaption" Text="Gerado em: Configurações → Agents → Adicionar Agent, no SaaS. Só é necessário na primeira instalação."
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                <TextBox x:Name="EnrollmentTokenTextBox"/>
                <TextBlock x:Name="SeedCustomerText" Visibility="Collapsed" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="Redes para varredura (discovery)" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Separe por vírgula. Ex.: 192.168.1.0/24, 192.168.2.100-192.168.2.200"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                <TextBox x:Name="NetworksTextBox"/>
            </StackPanel>
        </StackPanel>

        <!-- Sidebar + content: the 4 management screens. -->
        <Grid x:Name="ShellGrid" Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <ToggleButton x:Name="NavPrinters" Style="{StaticResource SidebarNavButton}" IsChecked="True" Click="NavButton_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖨" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Impressoras" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="76"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavTools" Style="{StaticResource SidebarNavButton}" Click="NavButton_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🛠" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ferramentas" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="76"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavStatus" Style="{StaticResource SidebarNavButton}" Click="NavButton_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✔" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Status do Client" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="76"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavSettings" Style="{StaticResource SidebarNavButton}" Click="NavButton_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Configurações" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="76"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20,0,20,16">
                <local:PrintersTabView x:Name="PrintersTab"/>
                <local:ToolsTabView x:Name="ToolsTab" Visibility="Collapsed"/>
                <local:StatusTabView x:Name="StatusTab" Visibility="Collapsed"/>
                <local:SettingsTabView x:Name="SettingsTab" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
