<Window x:Class="PrinterAgent.ConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrinterAgent.ConfigTool"
        mc:Ignorable="d"
        Title="Printer SaaS Agent" Height="560" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🖨" FontSize="28" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Printer SaaS Agent" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Descoberta e monitoramento de impressoras na rede local" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Verificando status..." FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Servidor: " Foreground="Gray"/>
            <TextBlock x:Name="ApiUrlText" FontFamily="Consolas" FontSize="11" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Token de instalação" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Gerado em: Configurações → Agents → Adicionar Agent, no SaaS" Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="EnrollmentTokenTextBox" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,16">
            <Button x:Name="InstallButton" Content="Instalar e Iniciar" Padding="14,8" Margin="0,0,8,0" Click="InstallButton_Click"/>
            <Button x:Name="StartButton" Content="Iniciar" Padding="14,8" Margin="0,0,8,0" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Parar" Padding="14,8" Margin="0,0,8,0" Click="StopButton_Click"/>
            <Button x:Name="UninstallButton" Content="Desinstalar" Padding="14,8" Click="UninstallButton_Click"/>
        </StackPanel>

        <DockPanel Grid.Row="5">
            <TextBlock DockPanel.Dock="Top" Text="Logs recentes" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="#1E1E1E" Foreground="#D4D4D4" TextWrapping="NoWrap"/>
        </DockPanel>
    </Grid>
</Window>
