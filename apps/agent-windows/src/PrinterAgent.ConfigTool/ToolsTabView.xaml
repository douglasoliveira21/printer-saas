<UserControl x:Class="PrinterAgent.ConfigTool.ToolsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
        <StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Buscar por rede / sub-rede" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Varre as redes configuradas em Configurações e envia o que encontrar para o SaaS."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    <Button x:Name="NetworkScanButton" Content="Buscar agora" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,4" Click="NetworkScanButton_Click"/>
                    <ProgressBar x:Name="NetworkScanProgress" Height="8" Minimum="0" Margin="0,4,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="NetworkScanStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Buscar via USB" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Lista impressoras instaladas nesta máquina via porta USB. Sem SNMP, os contadores não ficam disponíveis."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    <Button x:Name="UsbScanButton" Content="Buscar impressoras USB" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,8" Click="UsbScanButton_Click"/>
                    <ItemsControl x:Name="UsbResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Port}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Adicionar" Padding="8,3" Click="AddUsbPrinter_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Diagnóstico SNMP" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="Para impressoras que não trazem número de série, contadores etc. — consulta o IP diretamente e lista tudo que ela responde, para identificarmos o OID certo desse modelo."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DiagnosticIpTextBox" Grid.Column="0" Margin="0,0,8,0" />
                        <TextBox x:Name="DiagnosticCommunityTextBox" Grid.Column="1" Margin="0,0,8,0" />
                        <Button x:Name="DiagnosticRunButton" Grid.Column="2" Content="Consultar" Style="{StaticResource SecondaryButton}" Click="DiagnosticRunButton_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="IP da impressora — community à direita (padrão: public)" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button x:Name="DiagnosticCopyButton" Content="Copiar resultado" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Click="DiagnosticCopyButton_Click" Visibility="Collapsed"/>
                    <TextBox x:Name="DiagnosticResultText" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                             TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Height="260"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
